{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["bun", "node", "electron"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "test", "scripts"]
}
